# Production runtime template for chat.cotticoffee.com.
# Copy this file to /opt/lobechat-main/.env on the production server and fill secrets there.
# Do not commit real secrets.

# Release image verified on chatdev.
LOBECHAT_IMAGE=sg-ai-han-registry.ap-southeast-1.cr.aliyuncs.com/lobechat/lobehub:v2.2.1-cotti-20260531-212414-ea0b6997f2-eef7f94
LOBECHAT_BIND=0.0.0.0
LOBECHAT_PORT=3210

# Public app URLs.
APP_URL=https://chat.cotticoffee.com
INTERNAL_APP_URL=http://127.0.0.1:3210
AUTH_TRUST_HOST=true
AUTH_TRUSTED_ORIGINS=https://chat.cotticoffee.com,http://127.0.0.1:3210
PORT=3210
LOBE_PORT=3210

# Compose-managed ParadeDB/PostgreSQL.
POSTGRES_IMAGE=paradedb/paradedb:0.22.3-pg17
POSTGRES_USER=paradedb
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lobehub
DATABASE_DRIVER=node
DATABASE_URL=postgres://paradedb:CHANGE_ME@postgresql:5432/lobehub?sslmode=disable

# Compose-managed SearXNG.
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_URL=http://searxng:8080
SEARCH_PROVIDERS=searxng

# Brand.
NEXT_PUBLIC_BRAND_NAME=灵枢AI
NEXT_PUBLIC_BRAND_ASSISTANT_NAME=灵枢AI
NEXT_PUBLIC_BRAND_LOGO_URL=
SMTP_FROM=灵枢AI <cotti-ai@cotticoffee.com>

# Public chat model exposure. 深度思考 is temporarily disabled.
NEXT_PUBLIC_MODEL_VISIBLE_ALLOW=vertexai/gemini-3.5-flash,azure/gpt-5.5
NEXT_PUBLIC_MODEL_DISPLAY_NAMES=vertexai/gemini-3.5-flash=灵感探索,azure/gpt-5.5=全能效率
NEXT_PUBLIC_MODEL_SWITCH_GROUP_MODE=byModel
NEXT_PUBLIC_MODEL_SWITCH_HIDE_MANAGE_PROVIDER=1
NEXT_PUBLIC_MODEL_ALIAS_DESCRIPTION_REWRITE=1
NEXT_PUBLIC_COTTI_MODEL_BUILTIN_SEARCH_ALLOW=vertexai/gemini-*,google/gemini-*
NEXT_PUBLIC_COTTI_FORCE_PROVIDER_SEARCH=1

# Providers and model lists.
ENABLED_VERTEXAI=1
VERTEXAI_PROJECT=CHANGE_ME
VERTEXAI_LOCATION=global
VERTEXAI_CREDENTIALS=CHANGE_ME_JSON
VERTEXAI_MODEL_LIST=-all,gemini-3.5-flash=灵感探索<1114112:reasoning:vision:fc:video:search>,gemini-3.1-flash-image-preview:image=Nano Banana 2

ENABLED_AZURE_OPENAI=1
AZURE_ENDPOINT=https://ai-cotti0984ai154755897675.cognitiveservices.azure.com
AZURE_API_KEY=CHANGE_ME
AZURE_API_VERSION=2024-10-21
AZURE_MODEL_LIST=-all,gpt-5.5=全能效率<1050000:reasoning:vision:fc>,gpt-image-2=GPT Image 2
AZURE_IMAGE_API_KEY=CHANGE_ME
AZURE_IMAGE_BASE_URL=https://ai-cotti0984ai154755897675.cognitiveservices.azure.com
AZURE_IMAGE_API_VERSION=2025-04-01-preview
AZURE_IMAGE_MODEL_ID=gpt-image-2
AZURE_IMAGE_TIMEOUT_MS=600000

ENABLED_OPENAI=1
OPENAI_API_KEY=CHANGE_ME
OPENAI_PROXY_URL=CHANGE_ME
OPENAI_MODEL_LIST=-all,gpt-5.5=全能效率<1050000:reasoning:vision:fc>

ENABLED_ANTHROPIC=0
ANTHROPIC_API_KEY=CHANGE_ME_OPTIONAL
ANTHROPIC_PROXY_URL=CHANGE_ME_OPTIONAL
ANTHROPIC_MODEL_LIST=-all

ENABLED_FAL=0
ENABLED_COMFYUI=0
VOLCENGINE_MODEL_LIST=-all

# Image/video UI policy.
AI_IMAGE_DEFAULT_IMAGE_NUM=1
NEXT_PUBLIC_NAV_HIDE_IMAGE=0
NEXT_PUBLIC_HOME_STARTER_HIDE_IMAGE=0
NEXT_PUBLIC_NAV_HIDE_VIDEO=0
NEXT_PUBLIC_HOME_STARTER_HIDE_VIDEO=0
NEXT_PUBLIC_COTTI_HOME_HIDDEN_STARTER_MODELS=deepseek-v4-pro,video

# Platform management UI policy.
NEXT_PUBLIC_COTTI_SETTINGS_HIDDEN_TABS=provider,creds,apikey,messenger
NEXT_PUBLIC_COTTI_HOME_HIDDEN_BLOCKS=messengerBanner,starterList,botIntegrationBanner
NEXT_PUBLIC_NAV_HIDE_SETTINGS=0
NEXT_PUBLIC_PROVIDER_HIDE=

# System model defaults.
DEFAULT_AGENT_CONFIG=model=gemini-3.5-flash;provider=vertexai;chatConfig.searchMode=auto;chatConfig.useModelBuiltinSearch=true;chatConfig.urlContext=true;chatConfig.thinkingLevel=low
SYSTEM_AGENT=topic=vertexai/gemini-3.5-flash,generationTopic=vertexai/gemini-3.5-flash,translation=vertexai/gemini-3.5-flash,historyCompress=vertexai/gemini-3.5-flash,thread=vertexai/gemini-3.5-flash,agentMeta=vertexai/gemini-3.5-flash,inputCompletion=vertexai/gemini-3-flash-preview,promptRewrite=vertexai/gemini-3-flash-preview,followUpAction=openai/gpt-5.4-mini,memoryAnalysisAgentConfig=openai/gpt-5.4-mini,userMemoryPersonaWriter=openai/gpt-5.4-mini,userMemoryEmbedding=azure/text-embedding-3-small
DEFAULT_FILES_CONFIG=embedding_model=azure/text-embedding-3-small

# Auth. Fill production secrets on the server.
AUTH_SECRET=CHANGE_ME
JWKS_KEY=CHANGE_ME
KEY_VAULTS_SECRET=CHANGE_ME
AUTH_EMAIL_VERIFICATION=1
AUTH_ENABLE_MAGIC_LINK=1
AUTH_SSO_PROVIDERS=feishu,feishu-blue
AUTH_FEISHU_APP_ID=CHANGE_ME
AUTH_FEISHU_APP_SECRET=CHANGE_ME
AUTH_FEISHU_BLUE_APP_ID=CHANGE_ME
AUTH_FEISHU_BLUE_APP_SECRET=CHANGE_ME
AUTH_ALLOWED_EMAILS=cotticoffee.com,mail.cotti.com,abite.com,local.test,jichenghan@qq.com,449073428@qq.com

# External state services retained from old production unless explicitly changed.
REDIS_URL=CHANGE_ME
REDIS_PREFIX=lobechat_prod
REDIS_DATABASE=0
REDIS_TLS=false
S3_ENDPOINT=CHANGE_ME
S3_BUCKET=CHANGE_ME
S3_PUBLIC_DOMAIN=CHANGE_ME
S3_REGION=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_SET_ACL=0
S3_ENABLE_PATH_STYLE=0

# Email.
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# Optional integrations. Leave empty to keep disabled and avoid Klavis initialization.
KLAVIS_API_KEY=
MARKET_TRUSTED_CLIENT_ID=
MARKET_TRUSTED_CLIENT_SECRET=

# Existing dev-bypass settings should not be enabled for public production unless explicitly approved.
DEV_AUTH_BYPASS_ENABLED=0
DEV_AUTH_BYPASS_ALLOW_PROD=0
